    {
      "name": "tonghauhive",
      "url": "https://github.com/tonghauhive"
    },
    {
      "name": "amandac628",
      "url": "https://github.com/amandac628"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
