    "eslint-plugin-lit": "^1.8.3",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-sort-exports": "^0.8.0",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-wc": "^1.4.0",
    "fs-extra": "^11.3.3",
    "glob": "^13.0.6",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-order": "^1.2.0",
    "gulp-replace": "^1.1.4",
    "husky": "^8.0.0",
