    "rollup-plugin-visualizer": "^5.9.2",
    "sinon": "^21.0.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.4",
    "typescript": "^5.0.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "config": {
