{
  "name": "@govtechsg/sgds-web-component",
  "version": "3.28.0",
  "description": "",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "typings": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GovTechSG/sgds-web-component.git"
  },
  "scripts": {
    "dev": "VITE_ENV=development vite --open",
    "preview": "VITE_ENV=production vite --open",
    "build": "npm run cem && npm run build:react && rm -rf lib && rolldown --config rolldown.config.mjs && (tsc --emitDeclarationOnly --project tsconfig.json || true) && node ./scripts/generateSgdsTypes.mjs && node ./scripts/frankBuild.js && npm run generate:icons && npm run build:fouc",
    "build:react": "node ./scripts/makeReact.mjs",
    "build:readme": "gulp build-readme",
    "build:fouc": "node ./scripts/generateFoucStyle.mjs",
    "write:stories": "npm run cem && node ./scripts/generateStories.mjs && npm run concat:stories && npm run update:docs",
    "write:component": "plop",
    "test": "rm -rf test-outdir && rolldown --config rolldown.test.config.mjs && web-test-runner",
    "test:scripts": "wtr scripts/**/__tests__/**/*.test.{js,ts} --node-resolve",
    "prepare": "husky install",
    "concat:stories": "gulp concat-stories-js && gulp concat-storybook-mdx",
    "update:docs": "gulp replace-version-and-sri",
    "format": "prettier --ignore-path .prettierignore  --write \"**/*.+(js|ts|json)\"",
    "lint": "eslint --ignore-path .prettierignore --ext .js,.ts .",
    "lint:fix": "npm run lint -- --fix",
    "cem": "cem analyze --litelement ",
    "e2e-test": "node cypress/scripts/run_all.js & cypress open",
    "storybook": "nodemon --exec \"bash -c 'npm run utility:storybook && npm run write:stories && STORYBOOK_ENV=development npx storybook dev -p 6006'\" --watch stories/component-templates stories/getting-started src/css/utility.css -e js,mdx,css",
    "build-storybook": "npm run utility:storybook && npm run build && npm run write:stories && STORYBOOK_ENV=production storybook build --loglevel debug",
    "convert:icons": "node scripts/convertIcons.js && pnpm run generate:icons",
    "generate:icons": "node scripts/generateIconRegistry.js",
    "chromatic": "chromatic",
    "utility:dev": "tailwindcss -i ./src/css/utility.css -o ./playground/css/utility.css --config tailwind.config.js --watch",
    "utility:storybook": "tailwindcss -i ./src/css/utility.css -o ./.storybook/utility.css --config tailwind.config.js",
    "scan:snyk-agent": "tsx scripts/snyk-agent-scan/index.ts",
    "test:a11y": "tsx scripts/oobee-a11y-scan/index.ts",
    "test-storybook": "vitest run --project=storybook",
    "test:a11y:setup": "tsx scripts/oobee-a11y-scan/setup.ts"
  },
  "author": "GovTechSG",
  "contributors": [
    {
      "name": "rav3",
      "url": "https://github.com/rav3"
    },
    {
      "name": "haphizi",
      "url": "https://github.com/haphizi"
    },
    {
